# Claude Code worktrees and session data
.claude/

# macOS
.DS_Store

# Node
node_modules/

# One-off / ad-hoc functions scripts (many contain participant PII).
# Prevents accidental commits of UNTRACKED analysis scripts via broad
# `git add`. Already-tracked files are unaffected by this rule; add a new
# legitimate function file intentionally with `git add -f <file>`.
functions/*.js

# also ignore a node_modules symlink (a bare entry; "node_modules/" only matches folders)
node_modules
