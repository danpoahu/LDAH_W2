rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Website images - public read, authenticated write
    match /website/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Gallery images (CMS page editor uploads) - public read, authenticated write
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event images - public read, authenticated write
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event image uploads - public read, authenticated write
    match /event-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User uploads - private
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pacific island partner images - public read, authenticated write
    match /pacific/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PDF resources - public read, authenticated write
    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Team/board member photos - public read, authenticated write
    match /teamMembers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Volunteer opportunity images - public read, authenticated write
    match /volunteerOpportunities/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery 2 images - public read, authenticated write
    match /gallery2/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profile photos - any authenticated user can read, owners can write
    match /profilePhotos/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Event recording slides (PDF) - public read via signed download URL,
    // authenticated write. Cloud Function auto-deletes after 15 days.
    match /recordings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permanent member-archive slide copies (Past Event Recordings & Slides).
    // Public read via signed download URL; authenticated staff write. NOT
    // auto-deleted (unlike /recordings) — pruned with the record at 12 months.
    match /recordingsArchive/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Connect-Gen prep documents — public read so links in the prep email
    // resolve for parents. Admin-only write via the Firebase console / CLI.
    match /connect-gen-prep-docs/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Connect-Gen confidential documents (IEP + Evaluation).
    // All reads go through CF-mediated V4 signed download URLs which the
    // staff-side viewer requests via getConnectGenDocumentDownloadUrl.
    // Direct user-token reads/writes are forbidden by design (the CF auths
    // the staff role and audit-logs every URL issuance).
    match /connectGen/{eventId}/{signupId}/{file=**} {
      allow read: if false;
      allow write: if false;
    }

    // Case-advocacy confidential documents (IEP + evaluations + legal).
    // All reads go through CF-mediated V4 signed download URLs issued by
    // getCaseAdvocacyDocumentDownloadUrl. Direct client reads/writes are
    // forbidden; the CF authenticates staff role and audit-logs every
    // URL issuance. Uploads are likewise CF-mediated via Admin SDK.
    match /caseAdvocacy/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    // Paper screening consent forms scanned in by staff. A signed consent
    // names a child and carries a parent signature, so it is treated like the
    // other confidential child documents: no direct client read or write.
    // Uploads use a resumable URL minted by requestScreeningConsentUploadUrl
    // for one specific path; views are 10-minute V4 signed URLs issued by
    // getScreeningConsentDownloadUrl, which audit-logs every one.
    match /screeningConsents/{contactId}/{file=**} {
      allow read: if false;
      allow write: if false;
    }

    // Logos uploaded by anonymous applicants from become-partner.html.
    // Public read so admins can display the logo while reviewing the
    // application. Public create-only with strict size + MIME constraints
    // (NO svg — XSS vector). Once approved the resource gets the logo
    // copied to its real resources doc; if declined the file just sits
    // until cleaned up manually.
    match /resource-application-logos/{file} {
      allow read: if true;
      allow create: if request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
      allow update, delete: if request.auth != null;
    }
  }
}
