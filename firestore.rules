rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Categories collection - read by all, write by authenticated users
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // FAQs collection - read by all, write by authenticated users
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events collection - read by all, write by authenticated users
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Signups subcollection - public write for submissions
      match /signups/{signupId} {
        allow read: if request.auth != null;
        allow create: if true;  // Anyone can submit event signups
        allow update, delete: if request.auth != null;
      }
    }
    // Recurring Events collection - read by all, write by authenticated users
    match /recurringEvents/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
      // Signups subcollection - public write for submissions
      match /signups/{signupId} {
        allow read: if request.auth != null;
        allow create: if true;  // Anyone can submit recurring event signups
        allow update, delete: if request.auth != null;
      }
    }

    // Event Requests collection - write by all (for form submissions), read by authenticated users only
    match /eventRequests/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can submit an event request
      allow update, delete: if request.auth != null;
    }

    // Volunteer Opportunities collection - read by all, write by authenticated users
    match /volunteerOpportunities/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Volunteer Applications collection - write by all (for form submissions), read by authenticated users only
    match /volunteers/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can submit a volunteer application
      allow update, delete: if request.auth != null;
    }

    // Contact Form Submissions collection - write by all (for form submissions), read by authenticated users only
    match /contactSubmissions/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can submit a contact form
      allow update, delete: if request.auth != null;
    }

    // Provider Services Requests collection - write by all (for form submissions), read by authenticated users only
    match /providers/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can submit a provider request
      allow update, delete: if request.auth != null;
    }

    // Anti-Bullying Pledges collection - write by all (for form submissions), read by authenticated users only
    match /pledges/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can submit a pledge
      allow update, delete: if request.auth != null;
    }

    // Analytics collection - write by all (for tracking), read by authenticated users only
    match /analytics/{document=**} {
      allow read: if request.auth != null;
      allow create: if true; // Anyone can write analytics events
      allow update, delete: if request.auth != null;
    }

    // Site Analytics - public write for page tracking, read by authenticated users
    match /siteAnalytics/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if true;  // Tracker uses set({merge:true}) which needs create+update
      allow delete: if request.auth != null;
    }

    // Team Members collection - read by all, write by authenticated users
    match /teamMembers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Board Members collection - read by all, write by authenticated users
    match /boardMembers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Resources collection - read by all, write by authenticated users
    match /resources/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery collection - read by all, write by authenticated users
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery 2 collection (Volunteer page) - read by all, write by authenticated users
    match /gallery2/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Page Content collection - read by all (for website), write by authenticated users (CMS)
    match /pageContent/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
