rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Staff are people with a userRoles doc. This matters because
       `request.auth != null` is NOT "staff": the member portal lets members
       create their own Firebase Auth account (Members/index.html
       createUserWithEmailAndPassword), so any member — or anyone who signs up —
       satisfied that condition. */
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superAdmin';
    }

    /* Pacific partner scoping (2026-08-20, LDAH-Int v148.32).
       The `partner` role is the six Pacific Basin partner organizations.
       Their island lives in userRoles.location as the WEATHER_LOCATIONS label
       ('American Samoa', 'Guam', 'CNMI', 'Micronesia', 'Marshall Islands',
       'Palau'); LDAH-Int stamps the same label onto records they create as
       `partnerIsland`. Staff locations are Hawaiian island labels, so they
       never collide with a partnerIsland value. */
    function myRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role;
    }
    function myPartnerIsland() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.location;
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /signups/{signupId} {
        // Authenticated staff can read all; unauthenticated can read individual docs (for registration form)
        allow get: if true;
        allow list: if request.auth != null;
        allow create: if true;
        // Authenticated staff can update any signup
        allow update: if request.auth != null;
        // Unauthenticated registration: only pending→confirmed with registration data
        allow update: if request.auth == null
          && resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && request.resource.data.keys().hasAny(['registration', 'registrationCompletedAt']);
        // Unauthenticated feedback: only set feedbackSubmittedAt
        allow update: if request.auth == null
          && request.resource.data.keys().hasAny(['feedbackSubmittedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackSubmittedAt']);
        allow delete: if request.auth != null;
      }
      // Announcement recipients tracker (Cloud Function writes; admin reads for KPI)
      match /announcementRecipients/{recipientId} {
        allow read: if request.auth != null;
      }
    }
    match /recurringEvents/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /signups/{signupId} {
        // Authenticated staff can read all; unauthenticated can read individual docs (for registration form)
        allow get: if true;
        allow list: if request.auth != null;
        allow create: if true;
        // Authenticated staff can update any signup
        allow update: if request.auth != null;
        // Unauthenticated registration: only pending→confirmed with registration data
        allow update: if request.auth == null
          && resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && request.resource.data.keys().hasAny(['registration', 'registrationCompletedAt']);
        // Unauthenticated feedback: only set feedbackSubmittedAt
        allow update: if request.auth == null
          && request.resource.data.keys().hasAny(['feedbackSubmittedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackSubmittedAt']);
        allow delete: if request.auth != null;
      }
      match /announcementRecipients/{recipientId} {
        allow read: if request.auth != null;
      }
    }
    match /eventRequests/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /volunteerOpportunities/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /members/{document=**} {
      // Staff only. This collection is names, emails, phones and amounts, and
      // any signed-in member could previously read all of it. Nothing public
      // depends on this: the member portal reads through Cloud Functions on the
      // admin SDK, and no public page reads members at all (checked across
      // volunteer.html, Members/*, and the app's howtohelp.html).
      allow read: if isStaff();
      // Anyone may start a membership — the checkout is public and unauthenticated.
      // But an injected doc must not be able to arrive already "due": the follow-up
      // sweep reads createdAt/checkoutAbandonedAt to decide when to email, so a
      // backdated create would skip the 60-minute window entirely, and with the
      // sweep's 25/run cap that's still up to 2,400 emails/day from ldahawaii.org's
      // sending domain once armed. Verified against all five checkout writers
      // (volunteer.html, STAGE/volunteer.html, Members/renew.html,
      // STAGE/Members/renew.html, ../LDAH/howtohelp.html — and its STAGE mirror)
      // before shipping this: every one sets status:'pending' and createdAt via
      // serverTimestamp(), and none writes any field in the blocked list below.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny([
             'checkoutAbandonedAt', 'checkoutAbandonReason', 'nudgeCount',
             'lastNudgeAt', 'nudgeHistory', 'paidAt', 'paypalOrderId',
             'optedOut', 'optOutToken', 'resumeToken', 'archived', 'testSequence'
           ]);
      // Deleting a membership destroys the record behind a real payment.
      allow delete: if isSuperAdmin();
      // Staff may edit a membership but may NOT flip it to paid — that emails
      // the member and opens their portal login. Mirrors the dashboard, which
      // asks "are you sure they paid?" and shows the button to superAdmins only.
      allow update: if isStaff()
        && !(request.resource.data.status == 'paid' && resource.data.status != 'paid');
      // Marking paid: Super Admin only.
      allow update: if isSuperAdmin();
      // Public PayPal confirmation: an unauthenticated donor's browser may flip a
      // pending doc to paid, and ONLY the payment fields may change.
      // Not restricted to unauthenticated: a member renewing in the portal IS
      // signed in (Members/renew.html captures then writes these same three
      // fields), and would otherwise fall through to the staff rule and be
      // refused. Safe either way — only these keys, only out of pending.
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paypalOrderId', 'paidAt']);
      // Public retry (2026-07-29) + abandon stamp (2026-08-10): a donor whose
      // attempt failed may correct their own details, bump the attempt counter,
      // leave a diagnostic, and record THAT they walked away — all while the
      // record is still pending. The abandon stamp is what starts the follow-up
      // email clock; without it here the browser write is refused silently and
      // every abandonment falls back to the 60-minute sweep.
      // Cannot flip status, cannot touch a paid record, cannot write payment fields.
      // Same reasoning as above: signed-in renewals hit this too.
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email', 'phone', 'level', 'amount', 'secondParent',
                       'attempts', 'updatedAt', 'lastError', 'lastErrorAt',
                       'checkoutAbandonedAt', 'checkoutAbandonReason']);
    }
    match /volunteers/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    /* Pacific Partners "Getting Started" deck at ldahawaii.org/PIP/.
       The deck has no login -- people type their name and email on the first
       slide -- so it writes unauthenticated, the same way the public signup and
       feedback forms already do.

       update is allowed as well as create because the deck upserts ONE document
       per person as they move through the slides (doc id = session__email-slug)
       rather than appending a row per slide. Trade-off: someone who guessed a
       doc id could overwrite a progress record. The data is low value and holds
       nothing beyond the name and email the person typed about themselves.
       Deleting still needs a super admin. (2026-09-02) */
    match /partnerTrainingProgress/{docId} {
      allow read: if isStaff();
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /contactSubmissions/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /providers/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /pledges/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /analytics/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /siteAnalytics/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
    match /teamMembers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /boardMembers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /resources/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // "Become a Partner Resource" applications. Cloud Function (admin SDK)
    // creates docs; clients can never create. Admin/superAdmin staff can
    // read the queue and update status (approve / decline).
    match /resourceApplications/{document=**} {
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
      allow create, delete: if false;
    }
    // /system holds editable Cloud Function config: emailPersonas (sender
    // names + signatures), donateBlocks (donate copy + button), zoomDefault
    // (Zoom links), connectGenPrepDocs (consent prep PDF URLs), etc. CFs
    // read via admin SDK (bypasses rules). Admin/superAdmin staff can read
    // and update from the LDAH-Int Admin → List Management cards. No
    // create/delete from clients — schema is fixed.
    match /system/{docId} {
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
      allow create, delete: if false;
    }
    // Pre-fill verification codes (B'' OTP-by-email flow). Only the
    // requestPrefillCode + verifyPrefillCodeAndPrefill CFs (admin SDK)
    // ever read or write these. Clients must never see them — the code
    // is only valid against the verify CF.
    match /prefillCodes/{docId} {
      allow read, write: if false;
    }
    match /resourceActivity/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery2/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /pageContent/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Roles collection
    // - Users can read their own doc (login, profile)
    // - Admins/superAdmins can read any doc (user management, emergency contacts, etc.)
    // - Users can update their own doc BUT cannot change their role
    // - superAdmin has full write (create, delete, role changes)
    match /userRoles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /partners/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /* Contacts.
       READ is unchanged: any signed-in user. The three partner-visible reports
       filter to `partnerIsland` records in the client — that is a scoping
       convenience, not a confidentiality boundary, and always was.

       WRITE was superAdmin/admin only, which blocked the One-Off Event
       attendee quick-add for partners. Partners may now create a contact
       stamped to their OWN island and edit only those; they cannot re-stamp a
       record onto another island, and a Hawai'i family's record stays
       untouchable to them (no partnerIsland, so no comparison succeeds).
       A partner whose location does not resolve gets no stamp and therefore
       no write — it fails closed. */
    match /contacts/{docId} {
      allow read: if request.auth != null;
      allow create: if isStaff() && (
           myRole() in ['superAdmin','admin']
        || (myRole() == 'partner'
            && request.resource.data.partnerIsland == myPartnerIsland())
      );
      /* On update, request.resource.data is the MERGED result, so partnerIsland
         survives a partial update() and the equality below still holds. */
      allow update: if isStaff() && (
           myRole() in ['superAdmin','admin']
        || (myRole() == 'partner'
            && resource.data.partnerIsland == myPartnerIsland()
            && request.resource.data.partnerIsland == resource.data.partnerIsland)
      );
      allow delete: if isStaff() && (
           myRole() in ['superAdmin','admin']
        || (myRole() == 'partner'
            && resource.data.partnerIsland == myPartnerIsland())
      );
    }

    /* ══════════════════════════════════════════════════════════════════
       CERTIFICATION PROGRAM  (Members/certification.html)

       A member's course progress lives UNDER their contact, not in the
       `members` collection: `members` holds one doc per checkout ATTEMPT,
       so a renewing member has several and none of them is "the member".

       Note the parent rule `match /contacts/{docId}` above is a SINGLE
       path segment, so it does NOT reach these subcollections. Everything
       below is granted explicitly here; nothing widens the contacts rule.

       Ownership is the auth uid that getMemberProfile stamps on the contact
       (`memberAuthUid`, functions/index.js). certification.html calls that
       callable and waits for it BEFORE it touches Firestore, so the stamp
       is always present by the time these rules run. If the contact does
       not exist the get() errors and the request is DENIED, which is the
       outcome we want. */
    function _ownsContact(cid) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/contacts/$(cid)).data.memberAuthUid == request.auth.uid;
    }

    match /contacts/{cid}/certification/{docId} {
      // A member reads and writes their own progress. Staff read, never write.
      allow read: if _ownsContact(cid) || isStaff();
      allow write: if _ownsContact(cid);
    }

    match /contacts/{cid}/certificates/{certId} {
      /* Read-only to the member who earned it. Certificates are minted by
         the issueCertificate callable on the Admin SDK (which bypasses these
         rules) and are immutable — re-completing a tier must never reissue,
         renumber, or redate one. Same `allow write: if false` shape as
         photoReleases. */
      allow read: if _ownsContact(cid) || isStaff();
      allow write: if false;
    }

    /* The staff report reads every member's progress with a collectionGroup
       query. Those are evaluated against a recursive-wildcard rule, NOT the
       two paths above, so staff access is granted here and only here — a
       member running the same query matches this rule, fails isStaff(), and
       is refused. */
    match /{path=**}/certification/{docId} {
      allow read: if isStaff();
    }
    match /{path=**}/certificates/{certId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /interactions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Workshop & Presentation form, one doc per event (2026-08-19). Staff read
    // and write it; the Cloud Function watches it to move the task from Noe to
    // the ED to Admin. Signed-in staff only — it carries venue contacts and
    // travel arrangements, never anything public.
    match /workshopForms/{eventId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    /* Append-only audit trail on a workshop form (2026-08-20). Staff read and
       ADD entries; nobody edits or deletes one, so the record of who touched
       the form cannot be altered. The parent match above is single-segment and
       does not reach this subcollection. */
    match /workshopForms/{eventId}/activity/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    /* Volunteer help requests + their participants (2026-08-21). Staff manage
       them in -Int; the public confirm flow goes through Cloud Functions (Admin
       SDK, which bypasses rules), so the confirm tokens are never client-read. */
    match /volunteerRequests/{reqId} {
      allow read, write: if isStaff();
      match /participants/{pid} {
        allow read, write: if isStaff();
      }
    }
    match /volunteerConfirmTokens/{token} {
      allow read, write: if false;   // Admin SDK only
    }

    match /photoReleases/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // Resource Types are read by the PUBLIC become-partner form, so this one
    // managed doc gets public read. Writes still require admin. Placed BEFORE
    // the generic lookupLists rule (more specific first).
    match /lookupLists/resourceTypes {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin','admin'];
    }

    /* Channels and Interaction Types are locked to Daniel (2026-08-20).

       These two drive every interaction record in the system, and a value
       removed from them has twice come back on its own: an Int tab loaded
       before 2026-08-19 22:30 UTC still runs a loadLookupLists() that
       re-adds retired values, silently, stamped `auto-migrate`. Code cannot
       reach a browser that is already open — only this rule can, so the guard
       lives here.

       Two clauses, and both matter:
         - uid, not role. Five people hold superAdmin and any of their stale
           tabs would otherwise be able to write these lists.
         - `updatedBy != 'auto-migrate'`, which stops even DANIEL'S own stale
           tab from restoring a value automatically. A deliberate edit stamps
           a uid; only the auto-migrate path stamps that literal.

       NOTE ON SHAPE: Firestore ORs every matching rule, so a more specific
       match cannot narrow a broader one. The generic rule below therefore has
       to exclude these two docs by name — deleting that exclusion silently
       unlocks them again. */
    function isListOwner() {
      return request.auth != null && request.auth.uid in [
        'YmGV2TlBGqR01dVdxZ0rtFLEFCG3',   // danpellegrini63@gmail.com
        'Lwz0SNVIRAcC68tVQdzE2BBCapt1'    // dan@oahuappdesign.com — .IT_Help break-glass
      ];
    }
    match /lookupLists/channels {
      allow read: if request.auth != null;
      allow write: if isListOwner()
        && request.resource.data.updatedBy != 'auto-migrate';
    }
    match /lookupLists/interactionTypes {
      allow read: if request.auth != null;
      allow write: if isListOwner()
        && request.resource.data.updatedBy != 'auto-migrate';
    }

    match /lookupLists/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && !(docId in ['channels', 'interactionTypes'])
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superAdmin';
    }

    match /chatPresence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'superAdmin'
      );
    }

    match /chatConversations/{convId} {
      allow read, write: if request.auth != null;
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
      match /webrtcSignals/{signalId} {
        allow read, write: if request.auth != null;
      }
    }
    match /dailyReportRecipients/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }
    // Presenter staff list - source of the Event Summary Presenter dropdown.
    match /presenterStaff/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }
    match /changeRequests/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }
    match /notifications/{notifId} {
      // Recipients read their own. Daniel's account also reads any — the
      // LDAH-Int My Day "Viewing as" picker shows another staff member's
      // alerts read-only. Writes stay strictly recipient-scoped.
      allow read: if request.auth != null && (
        resource.data.recipientUid == request.auth.uid
        || request.auth.uid == 'YmGV2TlBGqR01dVdxZ0rtFLEFCG3'
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.recipientUid == request.auth.uid;
    }
    // Collection group query for signups (used by contact timeline in LDAH-Int)
    match /{path=**}/signups/{signupId} {
      allow read: if request.auth != null;
    }

    match /androidBetaRequests/{docId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /auditLog/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    // Record of every confidential document taken OFF the platform — backs the
    // Documents Downloaded report (2026-07-14). Create-only, like auditLog: a
    // record of data leaving that staff could edit or delete would be worthless.
    // Read is admin-only; these rows name families and their files.
    match /documentDownloads/{document=**} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /emailLog/{document=**} {
      // Only superAdmin and admin can read the email log. Cloud Functions
      // write via admin SDK (bypasses rules); clients cannot write.
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
      allow write: if false;
    }
    match /eventFeedback/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    // Weekly "what's new" training sessions shown as a splash in LDAH-Int.
    // Staff read them; only a Super Admin publishes, since everyone sees it.
    match /trainingSessions/{document=**} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }
    match /trainingVideos/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // SRP screening day-defaults (Site + Screened-by) so they auto-fill across
    // browsers for the day. Only staff (admin/superAdmin, who run the results
    // tool) can write; any signed-in staff can read.
    match /screeningDefaults/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // Member Portal resource hub (curated Links & Services, training,
    // newsletters). Staff manage it from the LDAH-Int CMS (admin write, staff
    // read). Members NEVER read directly — the getMemberResources Cloud
    // Function (admin SDK) serves it, gated on an active paid membership.
    match /memberResources/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // Past Event Recordings & Slides archive. Members NEVER read directly — the
    // getMemberRecordings Cloud Function (admin SDK) serves it, gated on active
    // membership. Staff (userRoles superAdmin/admin) read+write for the LDAH-Int
    // "Recordings archive" CMS. Members have no userRoles doc, so they cannot read.
    match /eventRecordings/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // Curated member-facing AI recaps. Staff publish/manage; members read via
    // the getMemberSummaries callable (admin SDK), so no client read is granted.
    match /memberSummaries/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // System failure alarms — written by monitor functions (admin SDK); staff
    // read them (red banner in Int) and update to acknowledge/dismiss.
    match /systemAlerts/{docId} {
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // Auto-on-send queue: LDAH-Int writes a job after emailing a recording; the
    // onRecordingPublishJob CF (admin SDK) processes it. Staff role-gated write.
    match /recordingPublishJobs/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role in ['superAdmin', 'admin'];
    }

    // Native Hawaiian Family Survey responses. Public submissions go
    // through submitNativeHawaiianSurvey CF (admin SDK, bypasses rules);
    // these rules are a safety belt only. No PII captured — just q1-q15
    // answers, submittedAt, and an SHA-256-hashed IP.
    match /nativeHawaiianSurveys/{docId} {
      allow read: if request.auth != null;
      allow create: if (request.resource.data.q1 is string || request.resource.data.q1 == null)
        && request.resource.data.keys().hasAll(['submittedAt', 'ipHash'])
        && (request.resource.data.q13 is string || request.resource.data.q13 == null);
      allow update, delete: if false;
    }

    // IP rate-limit ledger for the Native Hawaiian survey. Only the
    // CF (admin SDK) ever reads or writes. Clients must never access.
    match /nhSurveyIpHistory/{ipHash} {
      allow read, write: if false;
    }

    /* IT_Help auto-answer log (2026-09-01). One document per attempted reply,
       written ONLY by the itHelpAutoAnswer Cloud Function via the Admin SDK,
       which bypasses rules — so no client ever needs to write here, and a
       client that tries is a bug or worse.

       READ is superAdmin only, and deliberately narrower than the rest of the
       Reports screen: these documents carry the verbatim question a colleague
       typed and the answer they were given. That is a record of who asked for
       help and what they did not know, which is not something the whole staff
       should be able to browse. */
    match /itHelpLog/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /* Certificate serial counters, one doc per tier per year, bumped inside
       the transaction that mints a certificate number. Only issueCertificate
       (Admin SDK) ever touches these — a client must never be able to read
       the next serial or bump it. */
    match /certificateCounters/{counterId} {
      allow read, write: if false;
    }
  }
}




